{
  "name": "zoo-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:info && concurrently \"npm run server\" \"npm --prefix frontend run dev\"",
    "dev:info": "echo Starting backend and frontend together (concurrently)",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "server": "node backend/server.js",
    "install:frontend": "npm --prefix frontend install"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.21",
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "axios": "^1.8.4",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "nanoid": "^5.1.5",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.3"
  }
}
